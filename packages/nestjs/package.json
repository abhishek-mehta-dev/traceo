{
  "name": "@traceojs/nestjs",
  "version": "0.1.0",
  "description": "Traceo NestJS adapter — attach capture and the Ledger dashboard with minimal boilerplate",
  "license": "MIT",
  "author": "Abhishek Mehta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishek-mehta-dev/traceo.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/abhishek-mehta-dev/traceo#readme",
  "bugs": {
    "url": "https://github.com/abhishek-mehta-dev/traceo/issues"
  },
  "keywords": [
